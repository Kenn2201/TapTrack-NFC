# ─────────────────────────────────────────────
# TapTrack NFC — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/taptrack_nfc

# Server
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# NFC Domain (for generating card URLs)
NFC_DOMAIN=https://nfc.kenncode.me

# ─────────────────────────────────────────────
# v0.2.0+ (not yet implemented)
# ─────────────────────────────────────────────
# JWT_SECRET=           (required in production — no default allowed)
# JWT_EXPIRES_IN=7d
# RESEND_API_KEY=re_your_key_here
# RESEND_FROM_EMAIL=TapTrack NFC <no-reply@mail.nfc.kenncode.me>

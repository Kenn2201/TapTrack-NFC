# ─────────────────────────────────────────────
# TapTrack NFC — Environment Variables
# NEVER commit real credentials.
# ─────────────────────────────────────────────

# ── Backend / Render ──────────────────────────
# Render injects PORT automatically; do not hard-code it in production.
PORT=3001
NODE_ENV=development

# Exact frontend origin used by CORS, trusted-origin checks, and email links.
# Production: https://nfc.kenncode.me
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL connection string.
# Production should use the Neon connection string supplied by the project,
# normally with SSL enabled in the URL (for example sslmode=require).
DATABASE_URL=postgresql://user:password@localhost:5432/taptrack_nfc

# Automatic Drizzle deploy migrations.
# Defaults to true when omitted. Set false only as an emergency/manual override.
AUTO_MIGRATE=true

# Public NFC URL origin written to physical cards.
# Production: https://nfc.kenncode.me
NFC_DOMAIN=https://nfc.kenncode.me

# Authentication
JWT_SECRET=replace_with_generated_secret
JWT_EXPIRES_IN=7d

# NFC credential protection.
# Must be a DIFFERENT long random secret from JWT_SECRET.
# Changing this value invalidates every existing physical NFC credential.
CARD_TOKEN_PEPPER=replace_with_different_generated_secret

# Resend email
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=TapTrack NFC <no-reply@mail.nfc.kenncode.me>

# Optional server logging
LOG_LEVEL=info

# ── Frontend / Vercel ─────────────────────────
# Production: https://api.nfc.kenncode.me/api
VITE_API_URL=http://localhost:3001/api
